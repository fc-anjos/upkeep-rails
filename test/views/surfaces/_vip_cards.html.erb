<%# Adversarial: content gated on a per-user attribute (beta) that no viewer
    has at promotion time — indistinguishable from shared until the
    attribute flips mid-session. %>
<% vip = respond_to?(:current_user) && current_user&.beta? %>
<% if vip %><div id="vip">VIP LANE</div><% end %>
<ul id="cards">
  <% cards.each do |card| %>
    <li><%= card.title %></li>
  <% end %>
</ul>
