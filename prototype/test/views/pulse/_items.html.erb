<div id="items-region">
  <div id="viewer-tag"><%= respond_to?(:current_user) && current_user ? current_user.name : nil %></div>
  <ul id="items">
    <% items.each do |item| %>
      <li><%= item.title %> (#<%= item.position %>)</li>
    <% end %>
  </ul>
  <div id="total-box">
    <% cache ["pulse-total", Item.unscoped.maximum(:position)] do %>
      <p id="total">Top: <%= Item.order(:position).first&.title %></p>
    <% end %>
  </div>
</div>
