<%# Adversarial: identity-dependent content behind a defined? guard, so the
    scrubbed renderer (which has no current_user) renders it as a regular
    user would see it instead of raising. %>
<% admin = respond_to?(:current_user) && current_user&.admin? %>
<% if admin %><div id="admin-badge">ADMIN TOOLS</div><% end %>
<ul id="cards">
  <% cards.each do |card| %>
    <li><%= card.title %></li>
  <% end %>
</ul>
