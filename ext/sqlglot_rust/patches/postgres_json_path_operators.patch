+
+#[test]
+fn test_postgres_json_path_operators_roundtrip() {
+    for operator in ["#>", "#>>"] {
+        let sql = format!("SELECT data {} '{{commit,author,date}}' FROM commits", operator);
+        let stmt = parse(&sql, Dialect::Postgres).unwrap();
+
+        assert_eq!(generate(&stmt, Dialect::Postgres), sql);
+    }
+}
+
+#[test]
+fn test_postgres_json_path_operator_composes_with_cast() {
+    let sql = "SELECT CAST(data #>> '{commit,author,date}' AS TIMESTAMPTZ) FROM commits";
+    let stmt = parse(sql, Dialect::Postgres).unwrap();
+    let generated = generate(&stmt, Dialect::Postgres);
+
+    assert_eq!(parse(&generated, Dialect::Postgres).unwrap(), stmt);
+}
